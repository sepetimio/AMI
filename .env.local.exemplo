# Modelo do arquivo de ambiente. Copie para `.env.local` e preencha.
# `.env.local` fica fora do versionamento (.gitignore); este aqui entra, e
# por isso nunca recebe valor real.
#
# É um arquivo só, com todas as variáveis, de propósito: enquanto havia dois
# modelos, quem clonava o repositório configurava metade da aplicação e
# descobria a outra metade na primeira tela em branco.

# --- Supabase: o diretório médico. -----------------------------------------
# Painel do projeto em supabase.com, Settings, API. A URL é a do projeto e a
# chave é a anônima (anon public), nunca a de serviço: é a anônima que faz as
# políticas RLS do banco valerem.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Sanity: o conteúdo editorial. -----------------------------------------
# Project ID no topo da página do projeto em sanity.io/manage. O dataset é
# `production` a menos que você tenha criado outro.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Segredo do webhook que derruba o cache quando a AMI publica no Studio.
# Invente uma frase longa e cole a mesma em sanity.io/manage, API, Webhooks,
# campo Secret. Sem ela configurada, a rota /api/revalidar responde 500 de
# propósito: endpoint de invalidação aberto é negação de serviço barata.
SANITY_WEBHOOK_SECRET=

# --- O site. ---------------------------------------------------------------
# Endereço público, usado no sitemap, nos canônicos e no JSON-LD. Em produção,
# o domínio real da AMI, com https e sem barra no fim.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Trava de indexação: enquanto o cadastro publicado for o seed de demonstração
# (24 médicos fictícios), mantenha "true" para que o robots.txt bloqueie o
# site inteiro e o rodapé avise o visitante. Só mude para "false" depois de
# carregar o cadastro real da AMI. Qualquer outro valor conta como "true".
NEXT_PUBLIC_DADOS_DEMONSTRACAO=true

# --- O importador de planilha. ---------------------------------------------
# Chave SECRETA DEDICADA do Supabase, criada em Project Settings, API Keys,
# botão New secret key, com o nome `importador`. Não é a `service_role`: a
# service_role é a chave-mestra do projeto e não tem revogação isolada.
#
# Ela existe só para o comando `npm run importar`, que roda na sua máquina e
# fica fora do aplicativo. NUNCA leva prefixo NEXT_PUBLIC_ — com o prefixo, o
# valor vai para dentro do JavaScript que o navegador baixa. Não coloque na
# Vercel nem em nenhum serviço de hospedagem.
#
# Não precisa guardar cópia dela em lugar nenhum: se perder, revogue a antiga
# e crie outra. Ver docs/como-remontar-o-ambiente.md.
#
# Deixar em branco é aceitável: sem ela, o comando pergunta na hora de rodar
# e não grava o que você digitar.
SUPABASE_CHAVE_IMPORTADOR=
